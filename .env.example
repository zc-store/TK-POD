# Server Configuration
PORT=3001

# Jimeng (即梦) AI API
JIMENG_API_KEY=your_jimeng_api_key_here
JIMENG_API_SECRET=your_jimeng_api_secret_here

# Deepseek AI API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# TikTok Shop API
TIKTOK_SHOP_API_KEY=your_tiktok_shop_api_key_here
TIKTOK_SHOP_API_SECRET=your_tiktok_shop_api_secret_here
TIKTOK_SHOP_REGION=US
TIKTOK_SHOP_REDIRECT_URI=http://localhost:5173

# MongoDB Configuration
MONGODB_URI=your_mongodb_connection_string_here
MONGODB_DB_NAME=smart_listing

# Excel File Path
EXCEL_FILE_PATH=path_to_your_excel_file.xlsx

# Baidu AI API
BAIDU_AI_APPID=your_baidu_ai_appid_here
BAIDU_AI_API_KEY=your_baidu_ai_api_key_here
BAIDU_AI_SECRET_KEY=your_baidu_ai_secret_key_here
